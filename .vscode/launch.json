{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "前端",
            "request": "launch",
            "args": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal"
        },
        
        {
            "name": "后端",
            "type": "debugpy",
            "request": "launch",
            "module": "app.main",
            // "args": [
            //     "app.main:app",
            //     "--reload",
            //     "--host=0.0.0.0"
            // ],
            // "program": "${workspaceFolder}/backend/run.py",
            // "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}/backend",
            "jinja": true
        },
        {
            "name": "Flutter (Windows 桌面)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "program": "lib/main.dart",
            "deviceId": "windows",
            "debuggerType": "flutter",
            "flutterMode": "debug",
            "openDevTools": "logging"
        },
        {
            // iOS 模拟器调试。前提：
            // 1. xcode-select 指向完整 Xcode
            // 2. CocoaPods 已安装（brew install cocoapods）
            // 3. 对应模拟器已启动（关机状态不在扩展设备列表里，会报 Device not found）
            "name": "Flutter (iOS 模拟器)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "program": "lib/main.dart",
            "deviceId": "iPhone 18 Pro",
            "debuggerType": "flutter",
            "flutterMode": "debug",
            "openDevTools": "logging"
        },
        {
            // iPhone Duo：iOS 27.2 iPhone19-4 beta runtime（构建号 24B91016s 带 seed 后缀），
            // 新形态设备测试用。同样需要先启动：xcrun simctl boot "iPhone Duo"
            "name": "Flutter (iOS 模拟器 iPhone Duo)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "program": "lib/main.dart",
            "deviceId": "iPhone Duo",
            "debuggerType": "flutter",
            "flutterMode": "debug",
            "openDevTools": "logging"
        },
        {
            // 真机调试：需在 Xcode 里打开 mobile/ios/Runner.xcworkspace 配置签名团队
            // （自动签名），然后插上 iPhone 选择本配置；deviceId 留空由 VS Code 弹出设备选择。
            "name": "Flutter (iOS 真机)",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "program": "lib/main.dart",
            "debuggerType": "flutter",
            "flutterMode": "debug",
            "openDevTools": "logging"
        },

        // ───── 打包（只构建、不运行）──────────────────────────────────────────
        // Dart 扩展没有「只构建」的启动项，下面几个用 node 类型直接调起 flutter 命令
        // （与上面「前端」配置同一手法）：F5 后在集成终端跑完整构建，结束时进程退出。
        // 版本号取 mobile/pubspec.yaml 的 version（1.0.0+1 → versionName/versionCode、CFBundleVersion）。
        // 前提：终端里 `flutter --version` 可用；pub 镜像已在这里显式给出（dart.env 只作用于 Dart 扩展）。
        {
            // 产物：mobile/build/app/outputs/flutter-apk/app-release.apk
            // 直传手机/侧载用。需要 Android SDK + JDK 21（见 flutter doctor）。
            // 体积优先可加 "--split-per-abi"（按 ABI 出多个 apk，需分别安装）。
            "name": "Flutter 打包 (Android APK · release)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "flutter",
            "args": ["build", "apk", "--release"],
            "cwd": "${workspaceFolder}/mobile",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "env": {
                "PUB_HOSTED_URL": "https://pub.flutter-io.cn",
                "FLUTTER_STORAGE_BASE_URL": "https://storage.flutter-io.cn"
            }
        },
        {
            // 产物：mobile/build/app/outputs/bundle/release/app-release.aab
            // Google Play 上架用（Play 只收 AAB）。本地想装 AAB 验证可用 bundletool。
            "name": "Flutter 打包 (Android AAB · release)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "flutter",
            "args": ["build", "appbundle", "--release"],
            "cwd": "${workspaceFolder}/mobile",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "env": {
                "PUB_HOSTED_URL": "https://pub.flutter-io.cn",
                "FLUTTER_STORAGE_BASE_URL": "https://storage.flutter-io.cn"
            }
        },
        {
            // 产物：mobile/build/ios/ipa/*.ipa（同时留下 build/ios/archive/Runner.xcarchive）
            // 需要签名：先在 Xcode 里打开 mobile/ios/Runner.xcworkspace → Runner target →
            // Signing & Capabilities 选 Team（Bundle ID com.livecalc.livecalcMobile 需在开发者账号下注册）。
            // 分发方式默认 app-store；内测可用 "--export-method development" 或 "ad-hoc"。
            "name": "Flutter 打包 (iOS IPA · release)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "flutter",
            "args": ["build", "ipa", "--release"],
            "cwd": "${workspaceFolder}/mobile",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "env": {
                "PUB_HOSTED_URL": "https://pub.flutter-io.cn",
                "FLUTTER_STORAGE_BASE_URL": "https://storage.flutter-io.cn",
                // 本机 xcode-select 若退回 Command Line Tools，靠它找到完整 Xcode
                "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
            }
        },
        {
            // 产物：mobile/build/ios/iphoneos/Runner.app
            // 不签名编译验证（无需开发者账号 / Team），用来确认 iOS 侧代码与插件能编过。
            // 真机安装和上架必须走上面的 IPA 项。
            "name": "Flutter 打包 (iOS · 不签名验证)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "flutter",
            "args": ["build", "ios", "--release", "--no-codesign"],
            "cwd": "${workspaceFolder}/mobile",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "env": {
                "PUB_HOSTED_URL": "https://pub.flutter-io.cn",
                "FLUTTER_STORAGE_BASE_URL": "https://storage.flutter-io.cn",
                "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
            }
        }
    ]
}
