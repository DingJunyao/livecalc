<?xml version="1.0" encoding="utf-8"?>
<!--
  调试构建专用：放开全部明文 HTTP，便于真机连局域网内的自建服务器
  （192.168.x.x / 10.x.x.x 这类地址无法在发布配置里按网段白名单放行）。
  发布构建请走 src/main/res/xml/network_security_config.xml 的严格配置。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
